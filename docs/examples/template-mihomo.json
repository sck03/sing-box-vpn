{
  "id": "mihomo-split",
  "name": "桌面国内直连",
  "version": 1,
  "client": "mihomo",
  "mode": "config",
  "preset": "split",
  "private_network": true,
  "final": "AutoSelect",
  "groups": [
    {
      "id": "AutoSelect",
      "name": "自动选择",
      "type": "urltest",
      "scope": "normal",
      "interval_seconds": 900,
      "tolerance": 80
    },
    {
      "id": "Media",
      "name": "流媒体",
      "type": "select",
      "scope": "normal",
      "members": ["AutoSelect"]
    }
  ],
  "dns_policy": {
    "local": ["https://dns.alidns.com/dns-query"],
    "remote": ["https://cloudflare-dns.com/dns-query"],
    "bootstrap": ["223.5.5.5"],
    "fake_ip": true,
    "fake_ip_filter": ["*.lan", "localhost", "+.local"],
    "ipv6": false
  },
  "rules": [
    { "type": "domain_suffix", "value": "youtube.com", "target": "Media" }
  ],
  "native": { "external-controller": "127.0.0.1:9090" }
}
