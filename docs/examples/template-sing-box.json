{
  "id": "sing-box-split",
  "name": "移动端国内直连",
  "version": 1,
  "client": "sing-box",
  "mode": "config",
  "preset": "split",
  "private_network": true,
  "final": "AutoSelect",
  "tun": true,
  "groups": [
    {
      "id": "AutoSelect",
      "name": "自动选择",
      "type": "urltest",
      "scope": "normal",
      "interval_seconds": 900,
      "tolerance": 80
    },
    {
      "id": "Media",
      "name": "流媒体",
      "type": "select",
      "scope": "normal",
      "members": ["AutoSelect"]
    }
  ],
  "dns_policy": {
    "local": ["223.5.5.5"],
    "remote": ["https://cloudflare-dns.com/dns-query"],
    "bootstrap": ["223.5.5.5"],
    "fake_ip": false,
    "ipv6": false
  },
  "rules": [
    { "type": "domain_suffix", "value": "youtube.com", "target": "Media" }
  ]
}
