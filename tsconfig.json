{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": false
  },
  "include": [
    "internal/manage/panel/*.js",
    "internal/manage/panel/contracts.d.ts",
    "scripts/task-contracts.ts"
  ]
}
